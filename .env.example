# ─── Binance API ─────────────────────────────────────────────────────────────
# Futuros Perpetuos USDM. Para paper trading solo se necesita para datos de mercado.
# Crear en: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true   # true = usa Binance testnet (paper trading seguro)

# ─── Claude AI ───────────────────────────────────────────────────────────────
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Modo de Trading ─────────────────────────────────────────────────────────
TRADING_MODE=paper     # paper = simulado sin dinero real | live = dinero real

# ─── Pares a Monitorear ──────────────────────────────────────────────────────
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT

# ─── Timeframes de Análisis ──────────────────────────────────────────────────
TIMEFRAMES=15m,1h,4h   # 15m = timing entrada, 1h = tendencia, 4h = macro

# ─── Parámetros del Bot ──────────────────────────────────────────────────────
ANALYSIS_INTERVAL=300  # segundos entre cada ronda de análisis (default: 5 min)
MIN_CONFIDENCE=70      # confianza mínima de la IA para actuar en una señal (0-100)

# ─── Paper Trading ───────────────────────────────────────────────────────────
PAPER_BALANCE=10000    # balance virtual en USDT

# ─── Gestión de Riesgo ───────────────────────────────────────────────────────
RISK_PER_TRADE=1.0     # % del balance a arriesgar por trade
MAX_LEVERAGE=10        # apalancamiento máximo permitido
MAX_OPEN_POSITIONS=5   # máximo de posiciones simultáneas abiertas

# ─── Alertas (opcional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
